    "NSMicrophoneUsageDescription": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "仅在你开始录音时使用麦克风，录音保存在本机。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Quick Audio Trim uses the microphone only when you start recording. Recordings stay on this device."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "只有在你開始錄音時才使用麥克風，錄音儲存在本機。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "マイクは録音を開始したときだけ使います。録音はこの端末に保存されます。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Audio schneiden nutzt das Mikrofon nur, wenn du eine Aufnahme startest. Aufnahmen bleiben auf diesem Gerät."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Recortar Audio usa el micrófono solo cuando empiezas a grabar. Las grabaciones se quedan en este dispositivo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Couper un audio n’utilise le micro que lorsque vous lancez un enregistrement. Les enregistrements restent sur cet appareil."
          }
        }
      }
    },
