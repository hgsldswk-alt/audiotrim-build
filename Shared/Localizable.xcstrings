    "privacy.body": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "音频、录音、草稿和成品在设备内处理。App 不收集或上传文件，不使用账号、广告或统计。麦克风只在你启动录音时使用。内购和恢复购买由 Apple 处理；分享时，只有你选择的文件会交给所选目的地。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Audio, recordings, drafts and exports are processed on your device. The app does not collect or upload files and has no account, ads or analytics. Your microphone is used when you start recording. Apple handles purchases and restoration. Sharing sends only the item you select to the destination you choose."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "音訊、錄音、草稿和成品在裝置內處理。App 不收集或上傳檔案，不使用帳號、廣告或統計。麥克風只在你開始錄音時使用。內購和回復購買由 Apple 處理；分享時，只有你選擇的檔案會交給所選目的地。"
          }
        }
      }
    },
