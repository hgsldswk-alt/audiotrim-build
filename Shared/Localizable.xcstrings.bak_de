    "time.invalid": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请检查起止时间。选区需在原件内，通常至少 0.10 秒。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Check both times. Select at least 0.10 seconds within the original, or all of a shorter clip."
