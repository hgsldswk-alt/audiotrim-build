    "code.privacy": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "只分享时间和匹配原件所需的校验值。请把原件另发给对方。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Shares times and a fingerprint for matching. Send the original separately."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "只分享時間與比對原檔所需的校驗值。請另外將原檔傳給對方。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "時間と照合用のフィンガープリントを共有します。元のファイルは別に送ってください。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Teilt Zeiten und einen Fingerabdruck zum Abgleich. Sende das Original separat."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Comparte los tiempos y una huella para coincidir. Envía el original por separado."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Partage les temps et une empreinte pour la correspondance. Envoyez l’original à part."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Compartilha os tempos e uma impressão digital para conferir. Envie o original separadamente."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "시간과 일치 확인용 지문만 공유해요. 원본은 따로 보내세요."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Condivide i tempi e un’impronta per il confronto. Invia l’originale a parte."
          }
        }
      }
    },
