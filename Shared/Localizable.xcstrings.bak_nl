    "error.access": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无法读取文件。请在来源 App 或「文件」中下载后重新打开。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The file could not be read. Download it in the source app or Files and try opening it again."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "無法讀取檔案。請在來源 App 或「檔案」下載後重新開啟。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ファイルを読み込めませんでした。元のアプリや「ファイル」でダウンロードしてから、もう一度開いてください。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Datei konnte nicht gelesen werden. Lade sie in der Quell-App oder in Dateien herunter und öffne sie erneut."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se pudo leer el archivo. Descárgalo en la app de origen o en Archivos y vuelve a abrirlo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Impossible de lire le fichier. Téléchargez-le dans l’app source ou dans Fichiers, puis rouvrez-le."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Não foi possível ler o arquivo. Baixe-o no app de origem ou em Arquivos e abra de novo."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "파일을 읽을 수 없어요. 원래 앱이나 파일 앱에서 다운로드한 뒤 다시 열어 보세요."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Impossibile leggere il file. Scaricalo nell’app di origine o in File e riaprilo."
          }
        }
      }
    },
