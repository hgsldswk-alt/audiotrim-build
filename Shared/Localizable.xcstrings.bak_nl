          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "請檢查起迄時間。範圍需在原檔內，通常至少 0.10 秒。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "両方の時間を確認してください。元の長さの範囲で0.10秒以上を選ぶか、短いクリップは全体を選んでください。"
          }
        },
        "de": {
          "stringUnit": {
