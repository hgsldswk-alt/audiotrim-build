    "storage.detail": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "源文件大小包含原件副本和剪辑用音轨。删除最后一份草稿会清理对应源文件。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Source size includes the original copy and editing audio. Deleting the last draft removes its source."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "來源大小包含原檔副本和剪輯用音軌。刪除最後一份草稿會清理對應來源。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "元ファイルのサイズには、元のコピーと編集用の音声が含まれます。最後の下書きを削除すると元ファイルも削除されます。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Quellgröße umfasst die Originalkopie und das Bearbeitungsaudio. Wird der letzte Entwurf gelöscht, wird auch die Quelle entfernt."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El tamaño de origen incluye la copia del original y el audio de edición. Al borrar el último borrador se elimina su origen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La taille source comprend la copie de l’original et l’audio d’édition. Supprimer le dernier brouillon supprime sa source."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O tamanho de origem inclui a cópia do original e o áudio de edição. Apagar o último rascunho remove a origem."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "원본 크기에는 원본 사본과 편집용 오디오가 포함돼요. 마지막 초안을 삭제하면 원본도 삭제돼요."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La dimensione sorgente include la copia dell’originale e l’audio di modifica. Eliminando l’ultima bozza si elimina la sorgente."
          }
        }
      }
    },
