    "privacy.body": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "音频、录音、草稿和成品在设备内处理。App 不收集或上传文件，不使用账号、广告或统计。麦克风只在你启动录音时使用。分享时，只有你选择的文件会交给所选目的地。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Audio, recordings, drafts and exports are processed on your device. The app does not collect or upload files and has no account, ads or analytics. Your microphone is used when you start recording. Sharing sends only the item you select to the destination you choose."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "音訊、錄音、草稿和成品在裝置內處理。App 不收集或上傳檔案，不使用帳號、廣告或統計。麥克風只在你開始錄音時使用。分享時，只有你選擇的檔案會交給所選目的地。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "音声、録音、下書き、書き出しはこの端末上で処理されます。アプリはファイルを収集・アップロードせず、アカウント、広告、分析ツールもありません。マイクは録音を開始したときに使われます。共有では、選んだ項目だけが選んだ送り先に送られます。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Audio, Aufnahmen, Entwürfe und Exporte werden auf deinem Gerät verarbeitet. Die App sammelt oder lädt keine Dateien hoch und hat kein Konto, keine Werbung und keine Analyse. Das Mikrofon wird beim Starten einer Aufnahme genutzt. Beim Teilen geht nur das gewählte Element an das gewählte Ziel."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El audio, las grabaciones, los borradores y las exportaciones se procesan en tu dispositivo. La app no recoge ni sube archivos y no tiene cuenta, anuncios ni analíticas. El micrófono se usa cuando empiezas a grabar. Al compartir solo se envía lo que eliges al destino que elijas."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L’audio, les enregistrements, les brouillons et les exports sont traités sur votre appareil. L’app ne collecte ni n’envoie de fichiers et n’a ni compte, ni pub, ni statistiques. Le micro sert quand vous lancez un enregistrement. Le partage n’envoie que l’élément choisi vers la destination choisie."
          }
        }
      }
    },
